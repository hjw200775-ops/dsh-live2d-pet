{
  "name": "dsh-deepseek-live2d",
  "version": "0.6.3",
  "description": "DeepSeek-chan Live2D pet overlay for DSH. The model is available as a GitHub Release asset; Live2D Cubism Core is not included.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-live2d-fetch-model": "scripts/fetch-model.mjs"
  },
  "files": [
    "src/",
    "renderer/",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "docs/",
    "scripts/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12",
    "dsh": "^0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "dependencies": {
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10"
  },
  "scripts": {
    "preview": "node scripts/preview.mjs",
    "desktop": "electron desktop/main.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "live2d",
    "desktop-pet",
    "vtuber",
    "electron"
  ],
  "homepage": "https://github.com/hjw200775-ops/dsh-live2d-pet-#readme",
  "bugs": {
    "url": "https://github.com/hjw200775-ops/dsh-live2d-pet-/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjw200775-ops/dsh-live2d-pet-.git"
  },
  "devDependencies": {
    "electron": "^33.4.11"
  }
}
