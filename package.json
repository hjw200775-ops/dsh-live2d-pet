{
  "name": "dsh-deepseek-live2d",
  "version": "0.7.10",
  "description": "DSH 桌宠：装完重开 DSH 就自动出现独立透明桌面窗口。模型首次启动自动下载；Live2D Cubism Core 因授权限制需自行获取。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-live2d-setup": "scripts/setup.mjs",
    "dsh-live2d-doctor": "scripts/doctor.mjs",
    "dsh-live2d-import-core": "scripts/import-core.mjs",
    "dsh-live2d-fetch-model": "scripts/fetch-model.mjs",
    "dsh-live2d-desktop": "scripts/desktop.mjs"
  },
  "files": [
    "src/",
    "renderer/",
    "desktop/",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "docs/",
    "scripts/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12",
    "dsh": "^0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "dependencies": {
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10"
  },
  "scripts": {
    "preview": "node scripts/preview.mjs",
    "desktop": "node scripts/desktop.mjs",
    "setup": "node scripts/setup.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "live2d",
    "desktop-pet",
    "vtuber",
    "electron"
  ],
  "homepage": "https://github.com/hjw200775-ops/dsh-live2d-pet-#readme",
  "bugs": {
    "url": "https://github.com/hjw200775-ops/dsh-live2d-pet-/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjw200775-ops/dsh-live2d-pet-.git"
  }
}
